<script>
    var caURL = "/plugins/compose.manager/include/Exec.php";
    var logRefreshInterval = null;
    var autoScroll = true;

    function toggleHelp(dt) {
        var dl = dt.closest('dl');
        var blockquote = dl.querySelector('blockquote.inline_help');
        if (blockquote) {
            $(blockquote).slideToggle('fast');
        }
    }

    function clearAllIconCache() {
        swal({
            title: 'Clear Icon Cache',
            text: 'This will delete all locally cached icon files. Icons will be re-downloaded on next page load.',
            type: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Clear Cache'
        }, function(confirmed) {
            if (!confirmed) return;
            $.post(caURL, {
                action: 'clearAllIconCache'
            }, function(data) {
                var result = JSON.parse(data);
                if (result.result === 'success') {
                    swal('Success', 'Icon cache cleared (' + result.cleared + ' files removed).', 'success');
                } else {
                    swal('Error', result.message || 'Failed to clear icon cache', 'error');
                }
            });
        });
    }

    function clearUpdateCache() {        swal({
            title: 'Clear Update Cache',
            text: 'This will clear the update status cache and remove stale entries. You will need to check for updates again.',
            type: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Clear Cache'
        }, function(confirmed) {
            if (!confirmed) return;
            $.post(caURL, {
                action: 'clearUpdateCache'
            }, function(data) {
                var result = JSON.parse(data);
                if (result.result === 'success') {
                    swal('Success', 'Update cache has been cleared.', 'success');
                } else {
                    swal('Error', result.message || 'Failed to clear cache', 'error');
                }
            });
        });
    }

    function checkProjectFolder() {
        var projects_folder_not_empty = <?php echo json_encode($projects_exist); ?>;
        var original_folder = <?php echo json_encode($cfg['PROJECTS_FOLDER']); ?>;

        if (projects_folder_not_empty && ($(this).val() != original_folder)) {
            $("#PROJECTS_FOLDER_WARNING").show();
        } else {
            $("#PROJECTS_FOLDER_WARNING").hide();
        }
    }

    function toggleAutoCheckInterval() {
        var autoCheckEnabled = $('#AUTO_CHECK_UPDATES').is(':checked');
        $('#AUTO_CHECK_UPDATES_MODE').prop('disabled', !autoCheckEnabled);

        var mode = ($('#AUTO_CHECK_UPDATES_MODE').val() || 'daily').toLowerCase();
        var showCustom = autoCheckEnabled && mode === 'custom';
        $('#AUTO_CHECK_UPDATES_CUSTOM_WRAPPER').toggle(showCustom);
        $('#AUTO_CHECK_UPDATES_DAYS_CUSTOM').prop('disabled', !showCustom);
    }

    function normalizeAutoCheckDaysValue(rawValue, fallback) {
        var value = String(rawValue === undefined || rawValue === null ? '' : rawValue).trim();
        if (value === '') {
            return String(fallback || '1');
        }

        var parsed = parseFloat(value);
        if (isNaN(parsed) || parsed < 0) {
            return String(fallback || '1');
        }

        return String(parsed);
    }

    function resolveAutoCheckIntervalMode(daysRaw) {
        var days = parseFloat(normalizeAutoCheckDaysValue(daysRaw, '1'));
        if (Math.abs(days - 0) < 0.0001) return 'every_time';
        if (Math.abs(days - 0.04) < 0.005 || Math.abs(days - (1 / 24)) < 0.005) return 'hourly';
        if (Math.abs(days - 1) < 0.0001) return 'daily';
        if (Math.abs(days - 7) < 0.0001) return 'weekly';
        if (Math.abs(days - 30) < 0.0001) return 'monthly';
        return 'custom';
    }

    function presetDaysForAutoCheckMode(mode) {
        switch ((mode || '').toLowerCase()) {
            case 'every_time':
                return '0';
            case 'hourly':
                return '0.04';
            case 'daily':
                return '1';
            case 'weekly':
                return '7';
            case 'monthly':
                return '30';
            default:
                return null;
        }
    }

    function setAutoCheckIntervalUIFromDays(daysRaw) {
        var normalizedDays = normalizeAutoCheckDaysValue(daysRaw, '1');
        var mode = resolveAutoCheckIntervalMode(normalizedDays);
        $('#AUTO_CHECK_UPDATES_DAYS').val(normalizedDays);
        $('#AUTO_CHECK_UPDATES_MODE').val(mode);

        if (mode === 'custom') {
            $('#AUTO_CHECK_UPDATES_DAYS_CUSTOM').val(normalizedDays);
        } else {
            var presetDays = presetDaysForAutoCheckMode(mode);
            if (presetDays !== null) {
                $('#AUTO_CHECK_UPDATES_DAYS_CUSTOM').val(presetDays);
            }
        }

        toggleAutoCheckInterval();
    }

    function onAutoCheckModeChanged() {
        var mode = ($('#AUTO_CHECK_UPDATES_MODE').val() || 'daily').toLowerCase();
        var presetDays = presetDaysForAutoCheckMode(mode);

        if (presetDays !== null) {
            $('#AUTO_CHECK_UPDATES_DAYS').val(presetDays).trigger('change');
        } else {
            var customDays = normalizeAutoCheckDaysValue($('#AUTO_CHECK_UPDATES_DAYS_CUSTOM').val(), $('#AUTO_CHECK_UPDATES_DAYS').val() || '1');
            $('#AUTO_CHECK_UPDATES_DAYS_CUSTOM').val(customDays);
            $('#AUTO_CHECK_UPDATES_DAYS').val(customDays).trigger('change');
        }

        toggleAutoCheckInterval();
    }

    function onAutoCheckCustomDaysChanged() {
        var customDays = normalizeAutoCheckDaysValue($('#AUTO_CHECK_UPDATES_DAYS_CUSTOM').val(), $('#AUTO_CHECK_UPDATES_DAYS').val() || '1');
