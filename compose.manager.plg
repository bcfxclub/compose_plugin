<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name "compose.manager">
<!ENTITY author "mstrhakr">
<!ENTITY version     "2026.10.12.1026">
<!ENTITY launch "Settings/&name;.settings">
<!ENTITY packageVER "&version;">
<!ENTITY packageMD5  "f816ed2c0edce4586f629bc81dd82aa4">
<!ENTITY pkgBUILD    "1026">
<!ENTITY packageName "&name;-&packageVER;-noarch-&pkgBUILD;">
<!ENTITY packagefile "&packageName;.txz">
<!ENTITY github "mstrhakr/compose_plugin">
<!ENTITY pluginURL "https://raw.githubusercontent.com/&github;/dev/&name;.plg">
<!ENTITY packageURL "https://github.com/&github;/releases/download/v&version;/&packagefile;">
<!ENTITY pluginsPATH "/boot/config/plugins">
<!ENTITY pluginLOC "&pluginsPATH;/&name;">
<!ENTITY emhttpPATH "/usr/local/emhttp/plugins">
<!ENTITY emhttpLOC "&emhttpPATH;/&name;">
<!ENTITY pluginsInstalledPATH "/var/log/packages">
<!ENTITY aceVER    "1.43.5">
<!ENTITY aceURL    "https://github.com/ajaxorg/ace-builds/archive/refs/tags/v&aceVER;.zip">
<!ENTITY aceZIP    "ace-v&aceVER;.zip">
<!ENTITY aceSHA256 "40169719746a5f83dcfb6e73a838221d34b91b75a939569217d62fb7d8175562">
]>

<PLUGIN  name="&name;"
         author="&author;"
         version="&version;"
         launch="&launch;"
         pluginURL="&pluginURL;"
         icon="cubes"
         min="6.12.0"
         support="https://forums.unraid.net/topic/197334-plugin-compose-manager-plus/"
         project="https://github.com/mstrhakr/compose_plugin"
         readme="https://github.com/mstrhakr/compose_plugin#readme"
>

<CHANGES>
###2026.10.20.0925
- Features (git): read a git.json as plain JSON, byte order mark and all
- Features (git): compose-git deploy --dry-run
- Features (git): try a deploy of a git stack without deploying it
- Features (git): choose automatic deploys in the web UI, and see when a stack is behind
- Features (cron): run the scheduled git check every 15 minutes while a stack asks for it
- Features (git): check git stacks for new commits, and deploy them, on request
- Features (git): resume a git stack after a failed deploy
- Features (git): store whether a git stack is checked and deployed on a schedule
- Features (git): move an ssh stack onto another deploy key of its repository
- Features (git): one deploy key for every ssh stack of a repository
- Features (git): show changes made in the clone in an orange box, also above the compose file
- Features (git): say what deleting a git stack leaves behind
- Features (git): move an existing stack into git from the Sources tab
- Features (git): check a git stack for a newer commit from its stack menu
- Features (git): show a git stack's branch and deployed commit in the stack list
- Features (git): say in the editor where a git stack's compose file lives
- Features (git): deploy a git stack from its stack menu
- Features (git): add a git stack from the Add Stack dialog
- Features (git): show a git stack's repository on the editor's Sources tab
- Bug Fixes (credentials): do not delete a credential while the projects folder is missing
- Bug Fixes (credentials): keep a git credential that a broken git.json may name
- Bug Fixes (git): see a stack's deploy key when its git.json has a byte order mark
- Bug Fixes (credentials): count a git stack's credential when its git.json has a byte order mark
- Bug Fixes (cron): keep the git check for a git.json with a byte order mark
- Bug Fixes (git): check again under the stack's lock that an automatic deploy applies
- Bug Fixes (git): a dry run puts back only what its prune changed in the override
- Bug Fixes (git): deploy the commit the scheduled check compared
- Bug Fixes (git): give the scheduled check a lock no stack's lock can share
- Bug Fixes (git): forget cached file paths after checking out a commit
- Bug Fixes (git): read a clone's local changes without taking git's index lock
- Bug Fixes (git): say a full commit id can also be 64 characters
- Bug Fixes (git): name the deploy key boxes for screen readers
- Bug Fixes (git): read the deployed commit under the lock when checking for changes
- Bug Fixes (git): deploy in the checks' folder and environment, whatever starts it
- Bug Fixes (git): say why ssh-keyscan got no host keys
- Bug Fixes (git): say what to do when a reused deploy key is another repository's
- Bug Fixes (git): let the Credentials tab's git Test wait 15 seconds, not 60
- Bug Fixes (credentials): stop calling every credential a registry credential
- Bug Fixes: list a stack row's containers with docker ps, as the full list does
- Refactoring (git): let the deploy's checks return their problems
- Refactoring (git): take a stack's lock without waiting, for callers that do not throw
- Refactoring (git): share a git deploy's --wait arguments
- Refactoring (git): build a git deploy's compose.sh command in one place
- Documentation (git): say a dry run's check messages show values, as a deploy's do
- Documentation: automatic deploys of git stacks
- Documentation: say plainly what containersByProject returns for one project
- Documentation: git stacks in the web UI
- Tests: cover how containersByProject groups and filters docker ps rows
- Tests (e2e): add, deploy and delete a git stack through the web UI
- Tests (credentials): name the useCredential test after what it checks
- [PR #172](https://github.com/mstrhakr/compose_plugin/pull/172)
- [beta release diff](https://github.com/mstrhakr/compose_plugin/compare/v2026.10.07...v2026.10.20.0925)
</CHANGES>

<!-- The 'pre-install' script. -->
<FILE Run="/bin/bash">
<INLINE>
# Remove all but current package file and ace zip from plugin root
rm -f $(ls &pluginLOC;/&name;*.txz 2>/dev/null|grep -v '&packageVER;')
rm -f $(ls &pluginLOC;/ace-v*.zip 2>/dev/null|grep -v '&aceZIP;')

# Clean up legacy package entries (compose.manager-package-*) left by older builds
# that used non-standard Slackware naming and weren't removed by upgradepkg
for pkg in &pluginsInstalledPATH;/&name;-package-*; do
    [ -e "$pkg" ] &amp;&amp; removepkg "$(basename "$pkg")" 2>/dev/null || true
done

#Create projects folder if it doesnt exist
mkdir -p &pluginLOC;/projects
</INLINE>
</FILE>

<!-- The 'install' script. -->
<FILE Name="&pluginLOC;/&packagefile;" Run="upgradepkg --install-new">
<URL>&packageURL;</URL>
<MD5>&packageMD5;</MD5>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
echo ""
echo "----------------------------------------------------"
echo ""
echo "  Ace editor v&aceVER; will only be downloaded and"
echo "       installed for pre-7.0 Unraid versions."
echo ""
echo "  If on 7.0 or later, Ace editor files are included"
echo "      by default and skips will be shown below."
echo ""
echo "----------------------------------------------------"
echo ""
</INLINE>
</FILE>

<!-- Ace editor fallback for pre-7.0: download zip to flash cache -->
<FILE Name="&pluginLOC;/cache-&aceZIP;" Max="6.99.99">
<URL>&aceURL;</URL>
<SHA256>&aceSHA256;</SHA256>
</FILE>

<!-- Ace editor fallback for pre-7.0: copy cached zip to /tmp for extraction -->
<FILE Name="/tmp/temp-&aceZIP;" Max="6.99.99">
<LOCAL>&pluginLOC;/cache-&aceZIP;</LOCAL>
<SHA256>&aceSHA256;</SHA256>
</FILE>

<!-- Ace editor fallback for pre-7.0: extract needed JS files into plugin dir -->
<FILE Name="/tmp/ace-editor-install.sh" Run="/bin/bash" Max="6.99.99">
<INLINE>
&emhttpLOC;/scripts/install-ace.sh /tmp/temp-&aceZIP; &emhttpLOC; &aceVER;
rm -f /tmp/ace-editor-install.sh
</INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
echo ""
echo "----------------------------------------------------"
echo ""
echo "      Compose Manager Plus has been installed."
echo "               Version: &version;"
echo ""
echo "----------------------------------------------------"
echo ""
</INLINE>
</FILE>

<!-- Uninstall script; plus cleanup old/unused packages -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
# Remove all Slackware package entries for this plugin.
# Handles both new naming (compose.manager-VERSION-noarch-1) and
# legacy naming (compose.manager-package-VERSION) left by older builds.
for pkg in &pluginsInstalledPATH;/&name;-*; do
    [ -e "$pkg" ] &amp;&amp; removepkg "$(basename "$pkg")" 2>/dev/null || true
done

# Remove old package files from flash
rm -f $(ls &pluginLOC;/&name;*.txz 2>/dev/null|grep -v '&packageVER;')
</INLINE>
</FILE>

</PLUGIN>